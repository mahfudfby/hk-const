# ═══════════════ Hikimori Const — variabel lingkungan ═══════════════
# Salin ke .env (lokal) atau isi di Vercel → Settings → Environment Variables.
# Variabel berawalan VITE_ ikut terbundel ke browser → JANGAN isi rahasia di sini.
# Semua VITE_ di bawah OPSIONAL: bila dikosongkan, nilai bawaan di src/config/infra.js yang dipakai.

# ── Situs ─────────────────────────────────────────────────────────────
VITE_SITE_URL=https://hikimoriconst.com        # domain final (dipakai OG tags, sitemap, robots)

# ── Firebase — project "hk-const" (bawaan sudah terisi di src/config/infra.js) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FS_COLLECTION=                            # default: hikimoriconst

# ── Cloudinary — akun "dl4pyan8v" (upload gambar dari browser) ────────
VITE_CLOUDINARY_CLOUD_NAME=                    # default: dl4pyan8v
VITE_CLOUDINARY_UPLOAD_PRESET=                 # default: hikimori_const
# Upload preset UNSIGNED "hikimori_const" sudah dibuat di Cloudinary (Settings → Upload → Upload presets).
# Jangan ubah mode-nya menjadi Signed, atau upload dari Control Panel akan ditolak.

# ── Cloudinary SERVER-SIDE (hanya di Vercel, JANGAN pakai prefix VITE_) ──
# Dipakai /api/delete-cloudinary untuk menghapus aset. API Secret bersifat RAHASIA — jangan commit.
CLOUDINARY_CLOUD_NAME=dl4pyan8v
CLOUDINARY_API_KEY=457647378576613
CLOUDINARY_API_SECRET=                         # salin dari Cloudinary → Settings → API Keys (kolom API Secret)

# ── EmailJS (OTP "Lupa Password") — SENGAJA DIKOSONGKAN ───────────────
# Selama kosong, fitur lupa-password via email nonaktif dengan pesan yang jelas;
# login username + password tetap berjalan normal.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# ── Video hero bawaan (opsional) ──────────────────────────────────────
# Bawaannya masih menunjuk akun Cloudinary LAMA. Unggah ulang videonya ke akun dl4pyan8v
# lewat Control Panel → Hero Video, atau isi URL-nya di sini.
VITE_DEFAULT_HERO_VIDEO=

# ═══════════════ MARKETING & TRACKING ═══════════════
# Semua ID di bawah juga bisa diisi lewat Control Panel › Marketing & Tracking (tanpa build ulang).
VITE_GA4_ID=                 # default: G-22NHPZY4R7 (properti GA4 dari project Firebase hk-const)
VITE_GTM_ID=                 # GTM-XXXXXXX (opsional; bila diisi, event dikirim lewat GTM)
VITE_GADS_ID=                # AW-XXXXXXXXXX
VITE_GADS_LEAD_LABEL=        # label konversi "Lead"
VITE_GADS_WA_LABEL=          # label konversi "Klik WhatsApp"
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_CLARITY_ID=
VITE_META_DOMAIN_VERIFY=
VITE_GOOGLE_SITE_VERIFY=
VITE_IG_USER=hikimori_const
VITE_TIKTOK_USER=hikimori_const
VITE_SERVER_EVENTS=false     # true = kirim juga lewat /api/track (CAPI) — isi token server di bawah
VITE_CONSENT_REQUIRED=true   # false = tanpa banner cookie (pastikan sesuai regulasi)

# ── SERVER-SIDE (Vercel saja, tanpa VITE_) ────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=        # isi saat uji di Events Manager › Test Events, kosongkan di produksi
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
LEAD_WEBHOOK_URL=            # Google Apps Script / Zapier / Make / n8n / CRM
LEAD_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_ORIGINS=             # opsional, pisahkan koma bila ada domain tambahan
